{
  "schema_version": 1,
  "python": "3.12",
  "distribution": "mkdocs",
  "version": "1.6.1-compatible",
  "offline": true,
  "entry_points": [
    "mkdocs.config.load_config",
    "mkdocs.commands.build.build",
    "mkdocs.exceptions.MkDocsException",
    "mkdocs.exceptions.Abort",
    "mkdocs.exceptions.ConfigurationError",
    "mkdocs.exceptions.BuildError",
    "mkdocs.exceptions.PluginError",
    "mkdocs.structure.files.File",
    "mkdocs.structure.files.Files",
    "mkdocs.structure.files.get_files",
    "mkdocs.structure.nav.Link",
    "mkdocs.structure.nav.Section",
    "mkdocs.structure.nav.get_navigation",
    "mkdocs.structure.pages.Page"
  ],
  "dependencies": ["Jinja2", "Markdown", "PyYAML", "pathspec", "mergedeep", "packaging"]
}
